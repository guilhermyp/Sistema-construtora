  "descricao": "Mansão no Ecoville para cliente Ancelotti",
  "data_inicio": "2025-04-01",
  "data_fim": "2025-11-01",
  "status": "Em andamento",
  "custo_total": 3000000,
  "custo_atual": 2000000,
  "progresso": 78,
  "funcionario_id": null
}

### Listar Projetos
GET http://localhost:8000/projetos/projetos


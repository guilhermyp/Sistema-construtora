################################### MATERIAL #####################################

### Cadastrar Material
POST http://localhost:8000/materiais/materiais
Content-Type: application/json

{
  "nome": "Pedra",
  "unidade_medida": "M³",
  "preco": 17.50,
  "quantidade": 20,
  "fornecedor": "Votorantin",
  "projeto_id": 1
}

### Listar Materiais
GET http://localhost:8000/materiais/materiais

### Buscar Material por ID
GET http://localhost:8000/materiais/materiais/8

### Atualizar Material por ID
PUT http://localhost:8000/materiais/materiais/8
Content-Type: application/json

{
  "nome": "Cimento",
  "unidade_medida": "Saco",
  "preco": 25.00,
  "quantidade": 100,
  "fornecedor": "Votorantin",
  "projeto_id": 2
}

### Deletar Material por ID
DELETE http://localhost:8000/materiais/materiais/8



############################## FORNECEDOR #####################################

### Cadastrar Fornecedor
POST http://localhost:8000/fornecedores/fornecedores
Content-Type: application/json

{
  "cnpj": "10.345.678/0001-98",
  "nome": "Fornecedor de Pedra",
  "contato": "Pedra@fornecedor.com",
  "tipo_material": "Pedra"
}

### Listar Todos os Fornecedores
GET http://localhost:8000/fornecedores/fornecedores

### Buscar Fornecedor por ID
GET http://localhost:8000/fornecedores/fornecedores/6

### Atualizar Fornecedor por ID
PUT http://localhost:8000/fornecedores/fornecedores/6
Content-Type: application/json

{
  "cnpj": "10.345.678/0002-98",
  "nome": "Fornecedor de Cimento",
  "contato": "cimento@fornecedor.com",
  "tipo_material": "Cimento Pronto"
}

### Deletar Fornecedor por ID
DELETE http://localhost:8000/fornecedores/fornecedores/6

